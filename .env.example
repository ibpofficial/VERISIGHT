# ==============================================================================
# VERISIGHT — Environment Configuration Template
# SIH 2026 Problem Statement 26188: AI-Based Fake Identity & Document Screening System
# ==============================================================================

# Application & Environment
PROJECT_NAME=VERISIGHT
VERSION=1.0.0
ENVIRONMENT=development

# Security & Cryptography
SECRET_KEY=verisight-super-secret-key-change-in-production-sih2026-mha
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL for Docker production, SQLite for fast local development)
DATABASE_URL=sqlite:///./verisight.db
# DATABASE_URL=postgresql://verisight_user:verisight_secure_pass_2026@localhost:5432/verisight_db

# PostgreSQL Container Credentials (used by docker-compose)
POSTGRES_USER=verisight_user
POSTGRES_PASSWORD=verisight_secure_pass_2026
POSTGRES_DB=verisight_db

# Forensic Storage Directories
UPLOAD_DIR=./data/uploads
PROCESSED_DIR=./data/processed
REPORTS_DIR=./data/reports

# Demo Officer Credentials (Seeded automatically)
ADMIN_PASSWORD=Admin@12345
OFFICER_PASSWORD=Officer@12345
REVIEWER_PASSWORD=Reviewer@12345
AUDITOR_PASSWORD=Auditor@12345

# Feature Flags
ENABLE_FACE_VERIFICATION=true
SYNTHETIC_DATA_MODE=true

